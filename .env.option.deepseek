# OpenRouter — Open-source Chinese stack
# DeepSeek V3.1 for extraction + default, GLM-4.5-Air for summary, DeepSeek R1 for coding.
# Trade-off: lowest input price per token; pays R1 reasoning-token overhead on coding.
# Realized cost ~ $0.013 / encounter (~$128 / 10K encounters).
# See README → "Per-task model overrides" for the full comparison.

AI_PROVIDER=openai
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=sk-or-v1-CHANGE-ME

AI_MODEL=deepseek/deepseek-chat-v3.1
AI_MODEL_EXTRACT=deepseek/deepseek-chat-v3.1
AI_MODEL_SUMMARY=z-ai/glm-4.5-air
AI_MODEL_CODING=deepseek/deepseek-r1-0528

# Embeddings: OpenRouter proxies OpenAI embeddings reliably; OSS embedding
# providers (DeepInfra / Together with Qwen3-Embedding) need a different base URL.
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
