# Debugging preset — maximum signal across every layer.
#
# Use when chasing a tricky bug (PHI surfacing in a payload, Vite blocking
# requests, slow extractor, "ingest succeeded but no facts", etc).
#
# Apply:
#   cp .env.option.debug .env       # full replacement, OR
#   cat .env.option.debug >> .env   # append on top of an existing config
# then:
#   docker compose up --build
#
# Trade-offs:
# - LOG_LEVEL=DEBUG and VITE_DEBUG=1 produce *a lot* of output. Tail with
#   `docker compose logs -f backend frontend` and grep for what you want.
# - DEIDENTIFY_LEVEL=off skips the safe-harbor redactor so outbound AI
#   payloads carry whatever the extractor produced verbatim — handy to
#   confirm a prompt looks right, but **never run this against real PHI**.
# - QUEUE_WORKERS=0 disables the background job worker so async ingest
#   blocks the request — easier to read tracebacks, but breaks the
#   confirmation-dialog UX. Re-enable (>=1) when you're done.
#
# Revert by running `cp .env.example .env` and `docker compose up`.

# --- Backend verbosity ---
LOG_LEVEL=DEBUG
# Disable de-identification so you can see what the extractor literally
# sent to / received from the model. ONLY for synthetic data.
DEIDENTIFY_LEVEL=off
# Run all queue work inline so failures surface as HTTP responses (with
# full stacktrace) instead of being swallowed into a job row.
QUEUE_WORKERS=0

# --- Frontend verbosity (requires PR #39 — once merged these flip Vite into debug mode) ---
VITE_LOG_LEVEL=info
VITE_DEBUG=1
# Loosen host allow-list so reverse-proxy headers don't block requests
# while you debug routing — see docs/troubleshooting.md → "Blocked request".
VITE_ALLOWED_HOSTS=

# --- CORS / auth wide open ---
# Auth middleware off so curl / browser / Postman all work without setup.
# NEVER copy these two into a non-debug deployment.
CORS_ORIGINS=*
BACKEND_API_KEY=

# --- AI provider — stays on mock so you don't burn credits chasing bugs ---
# Override if you specifically need to debug a real provider's behavior.
AI_PROVIDER=mock
