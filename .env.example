# --- PostgreSQL ---
POSTGRES_USER=cng
POSTGRES_PASSWORD=cngpass
POSTGRES_DB=clinical_graph
POSTGRES_PORT=5432

# --- Neo4j ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpass
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_PAGECACHE=256m

# --- AI provider ---
# mock | openai | custom (any OpenAI-compatible endpoint — incl. OpenRouter, Groq, vLLM, ...)
AI_PROVIDER=mock

# OpenRouter (recommended for production trials — single key, many models)
# AI_PROVIDER=openai
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-v1-...
# AI_MODEL=anthropic/claude-3.5-sonnet
# AI_EMBEDDING_MODEL=openai/text-embedding-3-small
#
# OpenAI direct:
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
# AI_EMBEDDING_MODEL=text-embedding-3-small

AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Per-task overrides. Leave blank to use AI_MODEL.
# Useful for, e.g., using Claude Sonnet for the strict-JSON extract step
# while keeping gpt-4o-mini for cheap summaries.
AI_MODEL_EXTRACT=
AI_MODEL_SUMMARY=
AI_MODEL_CODING=

AI_EMBEDDING_MODEL=text-embedding-3-small

# --- Service ports (dev) ---
PROXY_PORT=80       # Caddy front-door: http://localhost
BACKEND_PORT=8000   # direct backend access for curl / tooling
FRONTEND_PORT=5173  # direct Vite HMR

# --- Frontend ---
# In dev, axios uses relative URLs (`/api/...`) so the API resolves to whatever
# origin served the page. As long as you open the UI via the Caddy proxy
# (http://localhost:${PROXY_PORT}), API calls hit the proxy and get routed to
# backend:8000 — no CORS configuration needed.
#
# If you need to call a backend on a different host or port (e.g. opening the
# UI directly from :5173 while the proxy is on :8081), set this to the absolute
# proxy URL: VITE_API_BASE=http://localhost:8081
VITE_API_BASE=

# --- Backend security & operations ---
# Comma-separated origins or "*" (dev only). Required as a real allowlist in prod.
CORS_ORIGINS=*
# If set, X-API-Key header is required on /api/emr, /api/config, /api/export, /api/facts.
BACKEND_API_KEY=
LOG_LEVEL=INFO

# --- De-identification (HIPAA Safe Harbor) ---
# Applied at the outbound boundary in ai_provider — every payload is stripped
# of PHI before it leaves the host. On-disk data stays unredacted.
#   off          — disable (BAA-bound deployments only)
#   regex_only   — fast regex sweep, no Presidio/PyThaiNLP overhead
#   safe_harbor  — regex + Presidio (English) + PyThaiNLP (Thai) — default
DEIDENTIFY_LEVEL=safe_harbor
DEIDENTIFY_NER_THRESHOLD=0.5

# --- Prod overlay only ---
# UVICORN_WORKERS=2
# FRONTEND_ORIGIN=https://cng.example.com   # CORS allowlist for the backend
# CNG_DOMAIN=cng.example.com                 # Caddy serves on this host, auto-fetches Let's Encrypt cert
# CADDY_EMAIL=ops@example.com                # cert renewal notifications
# PROXY_HTTP_PORT=80
# PROXY_HTTPS_PORT=443
