# --- PostgreSQL ---
POSTGRES_USER=cng
POSTGRES_PASSWORD=cngpass
POSTGRES_DB=clinical_graph
POSTGRES_PORT=5432

# --- Neo4j ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpass
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_PAGECACHE=256m

# --- AI provider ---
# mock | openai | ollama | custom (any OpenAI-compatible endpoint)
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# --- Service ports (dev) ---
BACKEND_PORT=8000
FRONTEND_PORT=5173
OLLAMA_PORT=11434

# --- Frontend ---
VITE_API_BASE=http://localhost:8000

# --- Backend security & operations ---
# Comma-separated origins or "*" (dev only). Required as a real allowlist in prod.
CORS_ORIGINS=*
# If set, X-API-Key header is required on /api/emr, /api/config, /api/export, /api/facts.
BACKEND_API_KEY=
LOG_LEVEL=INFO

# --- Prod overlay only ---
# UVICORN_WORKERS=2
# FRONTEND_ORIGIN=https://cng.example.com
