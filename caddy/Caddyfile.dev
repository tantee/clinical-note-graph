# Caddy: dev reverse proxy.
#
# Single front-door at http://localhost.
#   /api/*, /docs*, /openapi.json, /redoc, /health, /ready  → backend:8000
#   everything else                                         → Vite dev server (frontend:5173)
#
# WebSocket upgrades (Vite HMR) pass through automatically.

:80 {
    encode gzip zstd

    @backend {
        path /api/* /docs* /openapi.json /redoc* /health* /ready*
    }
    handle @backend {
        reverse_proxy backend:8000 {
            header_up X-Forwarded-Proto http
            header_up X-Forwarded-Host {host}
        }
    }

    handle {
        reverse_proxy frontend:5173
    }

    log {
        output stdout
        format console
        level INFO
    }
}
