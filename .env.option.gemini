# OpenRouter — Cost-only Western stack
# Gemini 2.5 Flash for extraction + default, Flash-Lite for summary, GPT-5-mini for coding.
# Trade-off: predictable cost (bounded reasoning tokens) and rock-solid JSON adherence;
# closed weights, US/EU-hosted upstreams (cleaner compliance story).
# Realized cost ~ $0.011 / encounter (~$107 / 10K encounters).
#
# Extract fit: gemini-2.5-flash handles the new prompt (severity, temporality,
# inter-fact relationships) reliably out of the box — no need to bump.
# See docs/ai-providers.md -> "Model-fit guidance for the extraction step".

AI_PROVIDER=openai
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=sk-or-v1-CHANGE-ME

AI_MODEL=google/gemini-2.5-flash
AI_MODEL_EXTRACT=google/gemini-2.5-flash
AI_MODEL_SUMMARY=google/gemini-2.5-flash-lite
AI_MODEL_CODING=openai/gpt-5-mini

AI_EMBEDDING_MODEL=openai/text-embedding-3-small
