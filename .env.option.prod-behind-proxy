# Production preset — HTTP only, no hostname.
#
# For when the stack sits behind another reverse proxy (nginx, Traefik,
# HAProxy, ELB, Cloudflare Tunnel, Caddy on the host…) that already
# terminates HTTPS. Caddy in this stack listens on :80, skips ACME, and
# trusts whatever X-Forwarded-* the upstream sends through.
#
# Apply:
#   cp .env.option.prod-behind-proxy .env
#   nano .env                                            # fill in the **bolded** placeholders below
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# Wire your upstream proxy to forward to host:80 (or whatever
# PROXY_HTTP_PORT you set below).
#
# See docs/deployment.md → "TLS modes" for the auto-TLS alternative.

# --- Caddy: HTTP-only behind upstream proxy ---
# Port-only bind. Caddy serves plain HTTP on :80, no TLS, no Let's
# Encrypt. The leading colon is what tells Caddy "address-only, no
# domain matching" — see caddy/Caddyfile.prod.
CNG_DOMAIN=:80
# CADDY_EMAIL is NOT required in this mode (no ACME, no renewal notices).
# Override CNG_TRUSTED_PROXIES if your upstream proxy lives outside
# the default `private_ranges` (docker bridge / k8s pods / RFC1918).
# CNG_TRUSTED_PROXIES=10.0.0.0/8,192.168.0.0/16
# HSTS only makes sense when *we* are the TLS endpoint. Either disable
# HSTS here and let your upstream send it, or leave the default if the
# upstream isn't HSTS-aware. To disable from Caddy:
# CNG_HSTS=max-age=0

# --- Backend: required prod vars ---
# CORS allow-list = the public-facing URL your upstream proxy exposes.
FRONTEND_ORIGIN=https://your-public-domain.example.com
# Rotate this. Treat like a credential.
BACKEND_API_KEY=CHANGE-ME-rotate-quarterly
# uvicorn worker count. Rule of thumb: vCPU - 1 so Postgres + Neo4j keep
# headroom on a single VM. Bump if ingest throughput is the bottleneck.
UVICORN_WORKERS=2
LOG_LEVEL=INFO

# --- Frontend bundle ---
# Baked into the JS bundle at build time so axios uses absolute URLs.
# Set to the public URL clients hit — typically your upstream proxy's hostname.
VITE_API_BASE=https://your-public-domain.example.com

# --- Postgres / Neo4j credentials ---
# Override the defaults from .env.example. Treat as secrets.
POSTGRES_USER=cng
POSTGRES_PASSWORD=CHANGE-ME-postgres-password
POSTGRES_DB=clinical_graph
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE-ME-neo4j-password
NEO4J_PAGECACHE=1g                      # match docs/deployment.md → Resource sizing

# --- AI provider — fill in for whichever LLM you're using ---
# Default to OpenRouter for production trials (one key, many models).
# See docs/ai-providers.md and the .env.option.{deepseek,gemini,hybrid}
# presets for known-good model combinations.
AI_PROVIDER=openai
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=sk-or-v1-CHANGE-ME
AI_MODEL=google/gemini-2.5-flash
AI_MODEL_EXTRACT=
AI_MODEL_SUMMARY=
AI_MODEL_CODING=
AI_EMBEDDING_MODEL=openai/text-embedding-3-small

# --- De-identification (must stay on for any real-data deployment) ---
DEIDENTIFY_LEVEL=safe_harbor
DEIDENTIFY_NER_THRESHOLD=0.5

# --- Host port map ---
# PROXY_HTTPS_PORT is harmless to leave at 443 (Caddy won't bind it in
# HTTP-only mode). Override PROXY_HTTP_PORT if :80 is taken on the host.
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
