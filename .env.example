# --- PostgreSQL ---
POSTGRES_USER=cng
POSTGRES_PASSWORD=cngpass
POSTGRES_DB=clinical_graph
POSTGRES_PORT=5432

# --- Neo4j ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpass
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_PAGECACHE=256m

# --- AI provider ---
# mock | openai | custom (any OpenAI-compatible endpoint — incl. OpenRouter, Groq, vLLM, ...)
AI_PROVIDER=mock

# OpenRouter (recommended for production trials — single key, many models)
# AI_PROVIDER=openai
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-v1-...
# AI_MODEL=anthropic/claude-3.5-sonnet
# AI_EMBEDDING_MODEL=openai/text-embedding-3-small
#
# OpenAI direct:
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
# AI_EMBEDDING_MODEL=text-embedding-3-small

AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# --- Service ports (dev) ---
PROXY_PORT=80       # Caddy front-door: http://localhost
BACKEND_PORT=8000   # direct backend access for curl / tooling
FRONTEND_PORT=5173  # direct Vite HMR

# --- Frontend ---
# In dev, axios talks to the Caddy proxy on :80. The proxy routes /api/*, /docs,
# /openapi.json, /redoc, /health, /ready to the backend; everything else hits Vite.
# Direct access to :5173 still works because axios is pointed at the same proxy origin.
VITE_API_BASE=http://localhost

# --- Backend security & operations ---
# Comma-separated origins or "*" (dev only). Required as a real allowlist in prod.
CORS_ORIGINS=*
# If set, X-API-Key header is required on /api/emr, /api/config, /api/export, /api/facts.
BACKEND_API_KEY=
LOG_LEVEL=INFO

# --- Prod overlay only ---
# UVICORN_WORKERS=2
# FRONTEND_ORIGIN=https://cng.example.com   # CORS allowlist for the backend
# CNG_DOMAIN=cng.example.com                 # Caddy serves on this host, auto-fetches Let's Encrypt cert
# CADDY_EMAIL=ops@example.com                # cert renewal notifications
# PROXY_HTTP_PORT=80
# PROXY_HTTPS_PORT=443
